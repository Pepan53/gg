# Zkopíruj jako .env.local a doplň vlastní hodnoty. Soubor .env.local nepatří do gitu.
# Oba klíče skončí v JavaScriptu v prohlížeči, jsou tedy veřejně viditelné.
# Omez je proto na svou doménu (u Mapy.com v nastavení projektu).

# Mapillary client token: https://www.mapillary.com/dashboard/developers
VITE_MAPILLARY_TOKEN=

# Mapy.com API klíč: https://developer.mapy.com/ -> Můj účet -> Projekty
VITE_MAPY_API_KEY=
